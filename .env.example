# Django Core Settings
SECRET_KEY=django-insecure-medicine-substitute-assistant-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MySQL)
# If DB_ENGINE is sqlite, it will use SQLite. If mysql, it connects to MySQL.
DB_ENGINE=sqlite
DB_NAME=medicine_substitute_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# Razorpay Configuration (Test Mode Credentials)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# CORS & Frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
